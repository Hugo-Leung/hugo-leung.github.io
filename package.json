{
  "name": "hugo-leung.github.io",
  "description": "Ching Him Leung personal website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hugo-Leung/hugo-leung.github.io.git"
  },
  "author": "Ching Him Leung",
  "license": "CC-BY-NC-ND-4.0",
  "dependencies": {
    "personal-web": "file:themes/personal-web"
  },
  "devDependencies": {
    "cspell-cli": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "scripts": {
    "prepare": "husky",
    "format:content": "prettier --write \"content/**/*.md\"",
    "check:content:format": "prettier --check \"content/**/*.md\"",
    "spellcheck:content": "cspell \"content/**/*.md\""
  },
  "lint-staged": {
    "content/**/*.md": [
      "prettier --write",
      "cspell"
    ]
  }
}
